agent.sources = source_logs
agent.channels = channel_hdfs channel_flink
agent.sinks = sink_hdfs sink_flink

# =========================
# SOURCE
# =========================
agent.sources.source_logs.type = TAILDIR
agent.sources.source_logs.positionFile = /var/lib/flume/taildir_position.json
agent.sources.source_logs.filegroups = app
agent.sources.source_logs.filegroups.app = /var/log/myapp/.*\.log
agent.sources.source_logs.fileHeader = true
agent.sources.source_logs.fileHeaderKey = source_file
agent.sources.source_logs.batchSize = 1000
agent.sources.source_logs.maxBackoffSleep = 1000
agent.sources.source_logs.interceptors = add_ingestion_header
agent.sources.source_logs.interceptors.add_ingestion_header.type = static
agent.sources.source_logs.interceptors.add_ingestion_header.key = ingestion_agent
agent.sources.source_logs.interceptors.add_ingestion_header.value = flume-taildir

# Cada evento é replicado: uma cópia segue para HDFS e outra para Flink.
agent.sources.source_logs.selector.type = replicating
agent.sources.source_logs.channels = channel_hdfs channel_flink

# =========================
# CHANNEL HDFS
# =========================
agent.channels.channel_hdfs.type = file
agent.channels.channel_hdfs.checkpointDir = /var/lib/flume/checkpoint-hdfs
agent.channels.channel_hdfs.dataDirs = /var/lib/flume/data-hdfs
agent.channels.channel_hdfs.useDualCheckpoints = true
agent.channels.channel_hdfs.backupCheckpointDir = /var/lib/flume/checkpoint-backup-hdfs
agent.channels.channel_hdfs.capacity = 100000
agent.channels.channel_hdfs.transactionCapacity = 1000
agent.channels.channel_hdfs.keep-alive = 3

# =========================
# CHANNEL FLINK
# =========================
agent.channels.channel_flink.type = file
agent.channels.channel_flink.checkpointDir = /var/lib/flume/checkpoint-flink
agent.channels.channel_flink.dataDirs = /var/lib/flume/data-flink
agent.channels.channel_flink.useDualCheckpoints = true
agent.channels.channel_flink.backupCheckpointDir = /var/lib/flume/checkpoint-backup-flink
agent.channels.channel_flink.capacity = 100000
agent.channels.channel_flink.transactionCapacity = 1000
agent.channels.channel_flink.keep-alive = 3

# =========================
# HDFS SINK (Larissa)
# =========================
agent.sinks.sink_hdfs.type = hdfs
agent.sinks.sink_hdfs.hdfs.path = hdfs://namenode:8020/data/raw/ecommerce/logs/%Y-%m-%d/%H
agent.sinks.sink_hdfs.hdfs.filePrefix = flume
agent.sinks.sink_hdfs.hdfs.fileSuffix = .log
agent.sinks.sink_hdfs.hdfs.inUsePrefix = .
agent.sinks.sink_hdfs.hdfs.fileType = DataStream
agent.sinks.sink_hdfs.hdfs.writeFormat = Text
agent.sinks.sink_hdfs.hdfs.batchSize = 1000
agent.sinks.sink_hdfs.hdfs.rollInterval = 60
agent.sinks.sink_hdfs.hdfs.rollSize = 134217728
agent.sinks.sink_hdfs.hdfs.rollCount = 0
agent.sinks.sink_hdfs.hdfs.idleTimeout = 120
agent.sinks.sink_hdfs.hdfs.callTimeout = 10000
agent.sinks.sink_hdfs.hdfs.round = true
agent.sinks.sink_hdfs.hdfs.roundValue = 1
agent.sinks.sink_hdfs.hdfs.roundUnit = minute
agent.sinks.sink_hdfs.hdfs.useLocalTimeStamp = true
agent.sinks.sink_hdfs.channel = channel_hdfs

# =========================
# FILE SINK PARA FLINK
# =========================
# O Flume grava uma cópia dos eventos em um volume compartilhado.
# O FileSource do Flink monitora esse diretório continuamente.
agent.sinks.sink_flink.type = file_roll
agent.sinks.sink_flink.sink.directory = /var/lib/flink-input
agent.sinks.sink_flink.sink.rollInterval = 5
agent.sinks.sink_flink.sink.batchSize = 100
agent.sinks.sink_flink.channel = channel_flink
