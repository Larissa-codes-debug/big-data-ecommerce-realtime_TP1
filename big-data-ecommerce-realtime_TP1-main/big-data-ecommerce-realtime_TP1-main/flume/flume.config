agent.sources = source_logs
agent.channels = channel_logs
agent.sinks = sink_hdfs

agent.sources.source_logs.type = TAILDIR
agent.sources.source_logs.positionFile = /var/lib/flume/taildir_position.json
agent.sources.source_logs.filegroups = app
agent.sources.source_logs.filegroups.app = /var/log/myapp/.*\.log
agent.sources.source_logs.fileHeader = true
agent.sources.source_logs.fileHeaderKey = source_file
agent.sources.source_logs.batchSize = 1000
agent.sources.source_logs.maxBackoffSleep = 1000

agent.sources.source_logs.interceptors = add_ingestion_header
agent.sources.source_logs.interceptors.add_ingestion_header.type = static
agent.sources.source_logs.interceptors.add_ingestion_header.key = ingestion_agent
agent.sources.source_logs.interceptors.add_ingestion_header.value = flume-taildir

agent.sources.source_logs.channels = channel_logs

agent.channels.channel_logs.type = file
agent.channels.channel_logs.checkpointDir = /var/lib/flume/checkpoint
agent.channels.channel_logs.dataDirs = /var/lib/flume/data
agent.channels.channel_logs.useDualCheckpoints = true
agent.channels.channel_logs.backupCheckpointDir = /var/lib/flume/checkpoint-backup
agent.channels.channel_logs.capacity = 100000
agent.channels.channel_logs.transactionCapacity = 1000
agent.channels.channel_logs.keep-alive = 3

agent.sinks.sink_hdfs.type = hdfs
agent.sinks.sink_hdfs.hdfs.path = hdfs://namenode:8020/data/raw/ecommerce/logs/%Y-%m-%d/%H
agent.sinks.sink_hdfs.hdfs.filePrefix = flume
agent.sinks.sink_hdfs.hdfs.fileSuffix = .log
agent.sinks.sink_hdfs.hdfs.inUsePrefix = .
agent.sinks.sink_hdfs.hdfs.fileType = DataStream
agent.sinks.sink_hdfs.hdfs.writeFormat = Text
agent.sinks.sink_hdfs.hdfs.batchSize = 1000
agent.sinks.sink_hdfs.hdfs.rollInterval = 60
agent.sinks.sink_hdfs.hdfs.rollSize = 134217728
agent.sinks.sink_hdfs.hdfs.rollCount = 0
agent.sinks.sink_hdfs.hdfs.idleTimeout = 120
agent.sinks.sink_hdfs.hdfs.callTimeout = 10000
agent.sinks.sink_hdfs.hdfs.round = true
agent.sinks.sink_hdfs.hdfs.roundValue = 1
agent.sinks.sink_hdfs.hdfs.roundUnit = minute
agent.sinks.sink_hdfs.hdfs.useLocalTimeStamp = true

agent.sinks.sink_hdfs.channel = channel_logs
